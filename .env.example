# 値はここに書かない。実値は Supabase Secrets / Vercel env / GitHub Actions Secrets のみ
#
# supabase start で取得（ローカル開発用）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
#
# Anthropic API（Investigator / Day0）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
#
# Resend（メール配信: Day0 / 週次 / アラート）
RESEND_API_KEY=
RESEND_FROM=
#
# Google OAuth（カレンダー接続）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# freee OAuth（会計接続・空でもビルド可）
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
#
# gBizINFO API（競合公的記録取得）
GBIZINFO_TOKEN=
